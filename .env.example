# Required settings. Compose loads .env; the standalone binary uses exported variables.
# In Docker, use a Cobalt address reachable from the container, not localhost.
COBALT=http://localhost:9000

# Required shared API key (sent in X-API-Key). Generate once with: openssl rand -hex 32
API_KEY=

# Optional overrides. Leave unset to use the defaults shown below.
# The Docker image defaults LISTEN to 0.0.0.0:8080; the standalone binary uses
# 127.0.0.1:8080. Changing the container port also requires changing its port mapping.
# LISTEN=0.0.0.0:8080

# Token refill rates per minute and maximum immediate bursts.
# RATE_LIMIT_PER_IP=20
# RATE_BURST_PER_IP=5
# RATE_LIMIT_GLOBAL=60
# RATE_BURST_GLOBAL=10
# MAX_CONCURRENT=4
# MAX_RATE_CLIENTS=10000

# Empty means ignore forwarded headers. Set only your proxy's actual CIDRs.
# Example for a reverse proxy on this host: 127.0.0.1/32,::1/128
# TRUSTED_PROXIES=

# Compose-only defaults: host bind address and image tag.
# SNATCHER_BIND=127.0.0.1
# SNATCHER_TAG=latest
